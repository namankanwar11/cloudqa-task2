AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_STEPS=25
MAX_REPLANS=3
ACTION_TIMEOUT_MS=5000
RUN_TIMEOUT_SECONDS=180
API_TIMEOUT_SECONDS=40
CAPTURE_SCREENSHOTS=true
# Explicit exact hosts for redirects/SSO beyond the starting host, comma-separated.
EXTRA_ALLOWED_HOSTS=
# Local demo only: loopback must be explicitly enabled. Private LAN hosts stay blocked.
ALLOW_LOCALHOST=false
# Secret placeholders available to instructions: {{CUSTOMER_EMAIL}}, {{CUSTOMER_PASSWORD}}
# Set optional values without embedding them in the test instruction.
# TEST_SECRET_CUSTOMER_EMAIL=
# TEST_SECRET_CUSTOMER_PASSWORD=